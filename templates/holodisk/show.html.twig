{% extends 'base.html.twig' %}

{% block active_tab %}larps{% endblock %}
{% block title %}{{ holodisk.title }} · Holodisk{% endblock %}
{% block status %}Holodisk playback{% endblock %}

{% block body %}
    <h1>{{ holodisk.title }}</h1>
    {{ include('holodisk/_media.html.twig') }}
    {% if holodisk.content is not empty %}
        <div class="holodisk-text">{{ holodisk.content|nl2br }}</div>
    {% endif %}
    <ul class="links"><li><a href="{{ path('app_pipboy') }}">Your LARPs</a></li></ul>
{% endblock %}
