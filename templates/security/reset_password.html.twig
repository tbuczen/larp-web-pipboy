{% extends 'base.html.twig' %}

{% block active_tab %}login{% endblock %}
{% block title %}PipBoy — New password{% endblock %}
{% block status %}Access terminal{% endblock %}

{% block body %}
    <h1>Choose a new password</h1>
    <p class="muted">For <strong>{{ email }}</strong>. At least 12 characters. This also signs you out on other devices.</p>
    {{ form_start(form) }}{{ form_widget(form) }}<button type="submit">Set new password</button>{{ form_end(form) }}
{% endblock %}
