{% extends 'base.html.twig' %}

{% block active_tab %}login{% endblock %}
{% block title %}PipBoy — {{ 'New password'|trans }}{% endblock %}
{% block status %}{{ 'Access terminal'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'Choose a new password'|trans }}</h1>
    <p class="muted">{{ 'For <strong>%email%</strong>. At least 12 characters. This also signs you out on other devices.'|trans({'%email%': email|e})|raw }}</p>
    {{ form_start(form) }}{{ form_widget(form) }}<button type="submit">{{ 'Set new password'|trans }}</button>{{ form_end(form) }}
{% endblock %}
