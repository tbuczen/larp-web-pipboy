{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Password reset · {{ label }}{% endblock %}
{% block content_title %}Password reset · {{ label }}{% endblock %}

{% block main %}
    {% if link %}
        <div class="admin-box">
            <label for="reset-link" class="form-label">Send this one-time link to {{ email }} (by Discord, SMS or in person):</label>
            <div class="input-group mb-3">
                <input id="reset-link" type="text" class="form-control" value="{{ link }}" readonly>
                <button type="button" class="btn btn-secondary" onclick="navigator.clipboard?.writeText(document.getElementById('reset-link').value); this.textContent = 'Copied';">Copy</button>
            </div>
            <p class="alert alert-warning mb-0" role="status">The link is shown only now. It works once and expires in 24 hours. Creating another link cancels this one.</p>
        </div>
    {% else %}
        <p class="text-muted">The app does not send email. Create a one-time link here and give it to the player; it lets them choose a new password for <strong>{{ email }}</strong>. It works once, expires in 24 hours, and signs the account out on other devices.</p>
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
            <button type="submit" class="btn btn-primary">Create reset link</button>
        </form>
    {% endif %}
{% endblock %}
