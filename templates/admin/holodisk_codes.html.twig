{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Holodisk codes · {{ larp.name }}{% endblock %}
{% block content_title %}Holodisk codes · {{ larp.name }}{% endblock %}
{% block page_actions %}<button type="button" class="btn btn-primary no-print" onclick="window.print()"><i class="fa fa-print"></i> Print</button>{% endblock %}

{% block main %}
    <p class="text-muted no-print">Print and place these in the game. Any phone camera opens the PipBoy from the QR code, and the PipBoy's DATA › Scan screen reads it directly; the printed text can be typed instead. Each player unlocks a holodisk once. Regenerating a code on the holodisk invalidates printed copies.</p>
    {% if cards is empty %}
        <p class="text-muted">This LARP has no holodisks yet.</p>
    {% else %}
        <div class="qr-sheet">
            {% for card in cards %}
                <figure class="qr-card">
                    <img src="{{ card.qr }}" alt="QR code for {{ card.holodisk.title }}" width="300" height="300">
                    <figcaption>
                        <span class="qr-card__code">{{ card.code }}</span>
                        <p class="qr-card__title no-print">{{ card.holodisk.title }}</p>
                    </figcaption>
                </figure>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
