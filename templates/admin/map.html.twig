{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Map · {{ larp.name }}{% endblock %}
{% block content_title %}Map · {{ larp.name }}{% endblock %}

{% block head_stylesheets %}
    {{ parent() }}
    {% if map %}<link rel="stylesheet" href="{{ asset('vendor/leaflet/leaflet.css') }}">{% endif %}
{% endblock %}

{% block head_javascript %}
    {{ parent() }}
    {% if map %}
        <script src="{{ asset('vendor/leaflet/leaflet.js') }}" defer></script>
        <script src="{{ asset('vendor/leaflet-imageoverlay-rotated/Leaflet.ImageOverlay.Rotated.js') }}" defer></script>
        <script src="{{ asset('js/admin-map-calibrate.js') }}" defer></script>
    {% endif %}
{% endblock %}

{% block main %}
    <p class="text-muted">Upload a drawn or scanned map of the game area, then drag it over OpenStreetMap until roads and buildings line up. Players see only your image, tinted like their PipBoy; their GPS position is shown on their own phone and never sent to the server.</p>

    {% if map %}
        <section class="map-calibrate admin-box mb-4" aria-labelledby="map-align-title">
            <div>
                <h2 id="map-align-title" class="h5">
                    Alignment
                    {% if map.aligned %}<span class="badge badge-success">saved</span>{% else %}<span class="badge badge-warning">not aligned yet</span>{% endif %}
                </h2>
                <p class="text-muted">Drag the <strong>✛</strong> handle to move the whole map, and the corner handles <strong>TL</strong>, <strong>TR</strong> and <strong>BL</strong> to scale and rotate it. Lower the opacity to compare with the streets underneath.</p>
                <div class="map-calibrate__tools">
                    <label class="form-label mb-0">Opacity <input type="range" min="0.1" max="1" step="0.05" value="0.6" data-map-opacity></label>
                    <button type="button" class="btn btn-secondary" data-map-fit>Place in current view</button>
                    <button type="button" class="btn btn-secondary" data-map-locate>Go to my location</button>
                </div>
                <div class="map-calibrate__canvas" id="map-calibrate"
                     data-image-url="{{ path('app_larp_map_image', {id: map.id, v: map.updatedAt.timestamp}) }}"
                     data-image-width="{{ map.imageWidth }}"
                     data-image-height="{{ map.imageHeight }}"
                     data-corners="{{ map.corners|json_encode }}">
                    <noscript><p class="alert alert-danger">Aligning the map needs JavaScript.</p></noscript>
                </div>
                <form method="post" action="{{ path('admin_larp_map_align', {id: larp.id}) }}" data-map-align-form>
                    <input type="hidden" name="_token" value="{{ csrf_token('map_align_' ~ larp.id) }}">
                    {% for corner in ['topLeft', 'topRight', 'bottomLeft'] %}
                        {% set point = map.corners ? attribute(map.corners, corner) : null %}
                        <input type="hidden" name="{{ corner }}Lat" value="{{ point ? point[0] }}" data-corner="{{ corner }}" data-axis="lat">
                        <input type="hidden" name="{{ corner }}Lng" value="{{ point ? point[1] }}" data-corner="{{ corner }}" data-axis="lng">
                    {% endfor %}
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="map-invert" name="invertColors" value="1"{{ map.invertColors ? ' checked' }}>
                        <label class="form-check-label" for="map-invert">Invert colours so dark lines glow on the PipBoy screen (for drawn, scanned or street maps; turn off for aerial photos)</label>
                    </div>
                    <button type="submit" class="btn btn-primary">Save alignment</button>
                </form>
                <p class="text-muted small mt-3 mb-0">Street map © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap contributors</a>, shown only on this page.</p>
            </div>
        </section>
    {% endif %}

    <section class="admin-box" aria-labelledby="map-upload-title">
        <div>
            <h2 id="map-upload-title" class="h5">{{ map ? 'Replace image' : 'Upload image' }}</h2>
            {{ form_start(form) }}{{ form_widget(form) }}<button type="submit" class="btn btn-primary">{{ map ? 'Replace image' : 'Upload map' }}</button>{{ form_end(form) }}
        </div>
    </section>
{% endblock %}
