{#- Player-facing layout styled as a wrist-terminal screen. Child templates
    set `active_tab` (login, register, larps) to highlight their tab. -#}
{%- set active = block('active_tab') is defined ? block('active_tab')|trim : '' -%}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#052308">
    {% block head %}{% endblock %}
    <title>{% block title %}PipBoy{% endblock %}</title>
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="16x16 32x32 48x48">
    <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}">
    <link rel="preload" href="{{ asset('fonts/vt323-regular.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ asset('css/pipboy.css') }}">
    {# Applied before the first paint so switching effects off never flashes them. #}
    <script>try { if (localStorage.getItem('pipboy-fx') === 'off') document.documentElement.dataset.fx = 'off'; } catch (e) {}</script>
    <script src="{{ asset('js/pipboy.js') }}" defer></script>
</head>
<body class="{% block body_class %}{% endblock %}">
<div class="terminal">
    {% block nav %}
    <nav class="tabs" aria-label="Sections">
        {% if app.user %}
            <a class="tab{{ active == 'larps' ? ' tab--active' }}" href="{{ path('app_pipboy') }}"{{ active == 'larps' ? ' aria-current="page"' }}>LARPs</a>
            {% if is_granted('ROLE_ORGANIZER') %}<a class="tab" href="{{ path('admin') }}">Admin</a>{% endif %}
            <a class="tab tab--end" href="{{ path('app_logout') }}">Sign out</a>
        {% else %}
            <a class="tab{{ active == 'login' ? ' tab--active' }}" href="{{ path('app_login') }}"{{ active == 'login' ? ' aria-current="page"' }}>Sign in</a>
            <a class="tab{{ active == 'register' ? ' tab--active' }}" href="{{ path('app_register') }}"{{ active == 'register' ? ' aria-current="page"' }}>Register</a>
            {# Organizers sign in here too; /admin sends anonymous visitors to the sign-in form and back. #}
            <a class="tab tab--end" href="{{ path('admin') }}">Admin</a>
        {% endif %}
    </nav>
    {% endblock %}

    <main class="screen" id="screen">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <p class="notice notice--{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message }}</p>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </main>

    {% block footer %}
    <footer class="status-bar">
        <span class="status-bar__cell">PipBoy</span>
        <span class="status-bar__cell status-bar__cell--wide">{% block status %}Personal terminal{% endblock %}<span class="cursor" aria-hidden="true"></span></span>
        <span class="status-bar__cell"><time datetime="{{ 'now'|date('Y-m-d') }}">{{ 'now'|date('d.m.Y') }}</time></span>
    </footer>
    {% endblock %}
</div>
</body>
</html>
