{# Fallout 4 style local map: the organizers' image tinted to the screen colour, with a grid and the player's own GPS marker. #}
<section class="pip-map-screen" aria-label="{{ 'Local map of %larp%'|trans({'%larp%': player.larp.name}) }}">
    <svg class="pip-map-filters" aria-hidden="true" focusable="false" width="0" height="0">
        <filter id="pip-map-tint" color-interpolation-filters="sRGB">
            {% if map.invertColors %}
                {# Inverted luminance (light paper turns dark, ink glows), mapped onto the phosphor green. #}
                <feColorMatrix type="matrix" values="-0.0234 -0.0787 -0.0079 0 0.11  -0.2083 -0.7009 -0.0708 0 0.98  -0.1063 -0.3576 -0.0361 0 0.5  0 0 0 1 0"/>
            {% else %}
                <feColorMatrix type="matrix" values="0.0234 0.0787 0.0079 0 0  0.2083 0.7009 0.0708 0 0  0.1063 0.3576 0.0361 0 0  0 0 0 1 0"/>
            {% endif %}
            <feComponentTransfer><feFuncG type="gamma" amplitude="1.1" exponent="1.4" offset="0.02"/></feComponentTransfer>
        </filter>
    </svg>
    <div class="pip-map" id="pip-map"
         data-image-url="{{ path('app_larp_map_image', {id: map.id, v: map.updatedAt.timestamp}) }}"
         data-corners="{{ map.corners|json_encode }}">
        <noscript><img src="{{ path('app_larp_map_image', {id: map.id, v: map.updatedAt.timestamp}) }}" alt="{{ 'Map of %larp%'|trans({'%larp%': player.larp.name}) }}"></noscript>
    </div>
    <div class="pip-map-controls">
        <button type="button" class="pip-map-button" data-map-zoom-in aria-label="{{ 'Zoom in'|trans }}">+</button>
        <button type="button" class="pip-map-button" data-map-zoom-out aria-label="{{ 'Zoom out'|trans }}">−</button>
        <button type="button" class="pip-map-button" data-map-reset aria-label="{{ 'Show the whole map'|trans }}">⌂</button>
        <button type="button" class="pip-map-button pip-map-button--locate" data-map-locate aria-pressed="false">{{ 'Locate'|trans }}</button>
    </div>
    <p class="pip-map-status" data-map-status role="status">{{ 'GPS OFF'|trans }}</p>
    <p class="muted small">{{ 'Your position is read on this phone only and never sent to the organizers.'|trans }}</p>
</section>
