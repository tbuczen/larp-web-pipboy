<section class="pip-stat">
    <p class="pip-stat__eyebrow">{{ player.larp.name }}</p>
    <h1>{{ player.name }}</h1>
    <dl class="data-row"><dt>{{ 'PipBoy number'|trans }}</dt><dd>{{ player.pipboyNumber }}</dd></dl>
    <dl class="data-row"><dt>{{ 'Status'|trans }}</dt><dd><span class="badge badge--{{ player.status.value }}">{{ player.status.value|trans }}</span></dd></dl>

    {% if player.status.value == 'pending' %}
        <p class="notice" role="status">{{ 'Waiting for organizer approval. Your modules come online once you are approved.'|trans }}</p>
    {% elseif player.status.value == 'rejected' %}
        <p class="error" role="status">{{ 'This registration was not approved. Contact the organizers if you think this is a mistake.'|trans }}</p>
    {% else %}
        <h2>{{ 'Modules'|trans }}</h2>
        <ul class="pip-modules">
            {% for t in tabs %}
                {% for s in t.screens|filter(s => s.key != 'status') %}
                    <li><a href="{{ path('app_pipboy_screen', {player: player.id, tab: t.key, screen: s.key}) }}"><span>{{ t.label|trans }} › {{ s.label|trans }}</span><span class="pip-modules__state">{{ 'Online'|trans }}</span></a></li>
                {% endfor %}
            {% endfor %}
        </ul>
        {% if tabs|length == 1 and tabs[0].screens|length == 1 %}
            <p class="muted">{{ 'No modules installed yet. Organizers enable them during the event.'|trans }}</p>
        {% endif %}
    {% endif %}
</section>
