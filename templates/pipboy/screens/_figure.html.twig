{#- STAT figure: an original line-art wastelander (not a game character) with six
    body-part bars. An active condition with a body part dims and blinks its bar
    and highlights that part of the figure. Screen left is the figure's right side. -#}
{% set parts = [
    {key: 'head', label: 'Head', slot: 'head'},
    {key: 'right_arm', label: 'Right arm', slot: 'arm-r'},
    {key: 'left_arm', label: 'Left arm', slot: 'arm-l'},
    {key: 'right_leg', label: 'Right leg', slot: 'leg-r'},
    {key: 'left_leg', label: 'Left leg', slot: 'leg-l'},
    {key: 'torso', label: 'Torso', slot: 'torso'},
] %}
{% set hurt = figure.marks|filter(conditions => conditions is not empty)|keys %}
<figure class="pip-figure" aria-label="Body status">
    {% for part in parts %}
        {% set conditions = figure.marks[part.key] %}
        <span class="pip-figure__bar pip-figure__bar--{{ part.slot }}{{ conditions is not empty ? ' is-hurt' }}"
              title="{{ part.label }}: {{ conditions is empty ? 'OK' : conditions|map(c => c.name)|join(', ') }}">
            <span class="visually-hidden">{{ part.label }}: {{ conditions is empty ? 'OK' : conditions|map(c => c.name)|join(', ') }}</span>
        </span>
    {% endfor %}
    <svg class="pip-figure__body" viewBox="0 0 200 300" aria-hidden="true" focusable="false">
        <g class="pip-figure__part{{ 'left_leg' in hurt ? ' is-hurt' }}">
            <path class="limb" d="M112 186 L124 236 L132 272"/>
            <path class="boot" d="M122 268 h24 q8 0 8 9 v3 h-34 z"/>
        </g>
        <g class="pip-figure__part{{ 'right_leg' in hurt ? ' is-hurt' }}">
            <path class="limb" d="M88 186 L80 232 L66 266"/>
            <path class="boot" d="M50 262 l20 4 q7 2 5 10 l-1 3 l-28 -6 z"/>
        </g>
        <g class="pip-figure__part{{ 'right_arm' in hurt ? ' is-hurt' }}">
            <path class="limb" d="M74 104 L58 140 L50 172"/>
            <circle class="hand" cx="49" cy="178" r="9"/>
        </g>
        <g class="pip-figure__part{{ 'torso' in hurt ? ' is-hurt' }}">
            <path class="suit" d="M74 98 q26 -8 52 0 l6 52 q2 22 -8 38 h-48 q-10 -16 -8 -38 z"/>
            <path class="detail" d="M86 98 l14 20 l14 -20 M100 118 v68 M70 158 h60"/>
            <rect class="detail" x="110" y="126" width="14" height="12"/>
        </g>
        <g class="pip-figure__part{{ 'left_arm' in hurt ? ' is-hurt' }}">
            <path class="limb" d="M126 104 L146 132 L162 118"/>
            <circle class="hand" cx="166" cy="113" r="9"/>
        </g>
        <g class="pip-figure__part{{ 'head' in hurt ? ' is-hurt' }}">
            <circle class="skin" cx="100" cy="62" r="30"/>
            <path class="helmet" d="M68 58 q2 -34 32 -36 q30 2 32 36 z"/>
            <path class="detail" d="M64 58 h72"/>
            <rect class="goggles" x="76" y="38" width="48" height="14" rx="7"/>
            <circle class="detail" cx="89" cy="45" r="4"/>
            <circle class="detail" cx="111" cy="45" r="4"/>
            <circle class="eye" cx="90" cy="68" r="3"/>
            <circle class="eye" cx="110" cy="68" r="3"/>
            <path class="detail" d="M88 78 q12 10 24 0"/>
        </g>
    </svg>
    {% if figure.conditionsVisible and hurt is not empty %}
        <figcaption class="pip-figure__caption">
            {% for key in hurt %}
                {% for condition in figure.marks[key] %}
                    <a href="{{ path('app_pipboy_screen', {player: player.id, tab: 'stat', screen: 'conditions', item: condition.id}) }}">{{ condition.name }}</a>{{ not loop.last ? ', ' }}
                {% endfor %}{{ not loop.last ? ' · ' }}
            {% endfor %}
        </figcaption>
    {% endif %}
</figure>
