{% extends 'base.html.twig' %}

{#- PipBoy shell for one player: main tabs, sub-tabs ("screens"), the screen
    itself and a segmented status bar. Neighbouring tabs are exposed as data
    attributes for swipe and arrow-key navigation (public/js/pipboy.js). -#}
{% set tab_index = 0 %}
{% for t in tabs %}{% if t.key == tab.key %}{% set tab_index = loop.index0 %}{% endif %}{% endfor %}
{% set prev_tab = tabs[(tab_index - 1 + tabs|length) % tabs|length] %}
{% set next_tab = tabs[(tab_index + 1) % tabs|length] %}
{% set screen_index = 0 %}
{% for s in tab.screens %}{% if s.key == screen.key %}{% set screen_index = loop.index0 %}{% endif %}{% endfor %}

{% block title %}{{ tab.label|trans|upper }} · {{ screen.label|trans }} · PipBoy{% endblock %}
{% block body_class %}is-pipboy{% endblock %}
{% block head %}
    {%- if screen.key == 'messages' and selected %}<script src="{{ asset('js/pipboy-chat.js') }}" defer></script>{% endif %}
    {%- if screen.key == 'motion' %}<script src="{{ asset('js/pipboy-motion.js') }}" defer></script>{% endif %}
    {%- if screen.key == 'scan' %}
        <script src="{{ asset('vendor/jsqr/jsQR.js') }}" defer></script>
        <script src="{{ asset('js/pipboy-scan.js') }}" defer></script>
    {%- endif %}
    {%- if screen.key == 'local' and map %}
        <link rel="stylesheet" href="{{ asset('vendor/leaflet/leaflet.css') }}">
        <script src="{{ asset('vendor/leaflet/leaflet.js') }}" defer></script>
        <script src="{{ asset('vendor/leaflet-imageoverlay-rotated/Leaflet.ImageOverlay.Rotated.js') }}" defer></script>
        <script src="{{ asset('js/pipboy-map.js') }}" defer></script>
    {%- endif %}
{% endblock %}

{% block nav %}
    <nav class="pip-nav" aria-label="PipBoy"
         data-prev-tab="{{ path('app_pipboy_screen', {player: player.id, tab: prev_tab.key}) }}"
         data-next-tab="{{ path('app_pipboy_screen', {player: player.id, tab: next_tab.key}) }}">
        <div class="pip-tabs">
            {% for t in tabs %}
                <a class="pip-tab{{ t.key == tab.key ? ' is-active' }}" href="{{ path('app_pipboy_screen', {player: player.id, tab: t.key}) }}"{{ t.key == tab.key ? ' aria-current="page"' }}>{{ t.label|trans }}
                    {%- if t.key == 'comms' and chat.unreadTotal > 0 %}<span class="pip-badge" title="{{ 'Unread messages'|trans }}">{{ chat.unreadTotal }}</span>{% endif -%}
                </a>
            {% endfor %}
            <details class="pip-menu">
                <summary class="pip-exit" title="{{ 'Menu'|trans }}" aria-label="{{ 'Menu'|trans }}">&#x23FB;</summary>
                <div class="pip-menu__panel">
                    <a class="settings-list__item" href="{{ path('app_pipboy') }}">{{ 'Your LARPs'|trans }}</a>
                    {{ include('_settings.html.twig') }}
                    <a class="settings-list__item settings-list__item--danger" href="{{ path('app_logout') }}">{{ 'Sign out'|trans }}</a>
                </div>
            </details>
        </div>
        <div class="pip-subtabs">
            {% for s in tab.screens %}
                {% set distance = (loop.index0 - screen_index)|abs %}
                <a class="pip-subtab pip-subtab--d{{ min(distance, 3) }}{{ s.key == screen.key ? ' is-active' }}"
                   href="{{ path('app_pipboy_screen', {player: player.id, tab: tab.key, screen: s.key}) }}"{{ s.key == screen.key ? ' aria-current="true"' }}>{{ s.label|trans }}</a>
            {% endfor %}
        </div>
    </nav>
{% endblock %}

{% block body %}
    {% if screen.key == 'status' %}
        {{ include('pipboy/screens/_status.html.twig') }}
    {% elseif screen.key == 'messages' %}
        {{ include('pipboy/screens/_messages.html.twig') }}
    {% elseif screen.key == 'motion' %}
        {{ include('pipboy/screens/_motion.html.twig') }}
    {% elseif screen.key == 'scan' %}
        {{ include('pipboy/screens/_scan.html.twig') }}
    {% elseif screen.key == 'local' and map %}
        {{ include('pipboy/screens/_map.html.twig') }}
    {% elseif screen.key == 'notes' %}
        {{ include('pipboy/screens/_notes.html.twig') }}
    {% elseif screen.key in ['conditions', 'holodisks'] %}
        {{ include('pipboy/screens/_entries.html.twig') }}
    {% else %}
        {{ include('pipboy/screens/_offline.html.twig') }}
    {% endif %}
{% endblock %}

{% block footer %}
    <footer class="status-bar pip-status">
        <span class="status-bar__cell" title="{{ 'PipBoy number'|trans }}">PB {{ player.pipboyNumber }}</span>
        <span class="status-bar__cell status-bar__cell--wide">{{ player.name }}</span>
        <span class="status-bar__cell"><time data-clock datetime="{{ now|date('c') }}">{{ now|date('H:i') }}</time></span>
        <button class="status-bar__cell fx-toggle" type="button" data-fx-toggle aria-pressed="true" title="{{ 'Screen effects'|trans }}">FX</button>
    </footer>
{% endblock %}
