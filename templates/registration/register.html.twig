{% extends 'base.html.twig' %}

{% block active_tab %}register{% endblock %}

{% block title %}Create your PipBoy account{% endblock %}
{% block status %}New user registration{% endblock %}

{% block body %}
    <h1>Create your account</h1>
    <p class="muted">Sign in after creating your account, then use an invitation from your organizer to join a LARP.</p>
    {% if discord_verified %}
        <p class="notice" role="status">Your Discord email is verified. Enter your name to complete your account.</p>
    {% elseif discord_enabled %}
        <a class="button button--ghost" href="{{ path('connect_discord') }}">Register with Discord</a>
        <hr>
    {% endif %}
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit">Create account</button>
    {{ form_end(form) }}
    <p class="muted">Your first and last name are visible only to organizers.</p>
    <ul class="links">
        <li><a href="{{ path('app_login') }}">Already have an account? Sign in</a></li>
    </ul>
{% endblock %}
