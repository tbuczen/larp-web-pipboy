{% extends 'base.html.twig' %}

{% block active_tab %}register{% endblock %}

{% block title %}Create your PipBoy account{% endblock %}
{% block status %}Access terminal{% endblock %}

{% block body %}
    {# Same structure as security/login.html.twig: heading, one-line intro,
       form, main button, Discord, divider, link to the other page, footnote. #}
    <h1>Register</h1>
    <p class="muted">Create your account, then join a LARP with your organizer's invitation.</p>
    {% if discord_verified %}
        <p class="notice" role="status">Your Discord email is verified. Enter your name to complete your account.</p>
    {% endif %}
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit">Create account</button>
    {{ form_end(form) }}
    {% if discord_enabled and not discord_verified %}<a class="button button--ghost" href="{{ path('connect_discord') }}">Register with Discord</a>{% endif %}
    <hr>
    <ul class="links">
        <li><a href="{{ path('app_login') }}">Already have an account? Sign in</a></li>
    </ul>
    <p class="muted">Your first and last name are visible only to organizers.</p>
{% endblock %}
