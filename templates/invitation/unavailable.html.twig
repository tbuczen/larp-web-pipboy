{% extends 'base.html.twig' %}

{% block title %}Invitation unavailable{% endblock %}
{% block status %}Signal lost{% endblock %}

{% block body %}
    <h1>Invitation unavailable</h1>
    <p class="error" role="alert">This invitation has expired, was revoked, or has already been accepted. Ask your organizer for a new invitation.</p>
    {% if not app.user %}<a class="button" href="{{ path('app_login') }}">Sign in</a>{% endif %}
{% endblock %}
