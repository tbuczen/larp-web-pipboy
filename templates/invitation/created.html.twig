{% extends 'base.html.twig' %}

{% block title %}Invitation created{% endblock %}
{% block status %}Organizer console{% endblock %}

{% block body %}
    <h1>Invitation created</h1>
    <dl class="data-row"><dt>For</dt><dd>{{ invitation.email }}</dd></dl>
    <dl class="data-row"><dt>LARP</dt><dd>{{ invitation.larp.name }}</dd></dl>
    <dl class="data-row"><dt>Expires</dt><dd>{{ invitation.expiresAt|date('Y-m-d H:i T') }}</dd></dl>
    <div class="field">
        <label for="invitation-link">Send this personal link to the player:</label>
        <input id="invitation-link" type="text" value="{{ link }}" readonly>
    </div>
    <p class="notice" role="status">This link is shown only now. You can revoke the invitation and generate another if needed.</p>
    <ul class="links"><li><a href="{{ path('admin') }}">Back to admin</a></li></ul>
{% endblock %}
