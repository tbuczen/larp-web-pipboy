{% extends 'base.html.twig' %}

{% block title %}Revoke invitation{% endblock %}
{% block status %}Organizer console{% endblock %}

{% block body %}
    <h1>Revoke invitation for {{ invitation.email }}?</h1>
    <p class="muted">This prevents use of the link. It does not remove a player who has already joined.</p>
    {{ form_start(form) }}<button class="button--danger" type="submit">Revoke invitation</button>{{ form_end(form) }}
    <ul class="links"><li><a href="{{ path('admin') }}">Back to admin</a></li></ul>
{% endblock %}
