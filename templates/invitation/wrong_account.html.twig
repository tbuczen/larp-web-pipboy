{% extends 'base.html.twig' %}

{% block title %}{{ 'Another account required'|trans }}{% endblock %}
{% block status %}{{ 'Access denied'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'Another account required'|trans }}</h1>
    <p class="error" role="alert">{{ 'Sign in with the account this invitation was issued to.'|trans }}</p>
    <a class="button" href="{{ path('app_logout') }}">{{ 'Sign out'|trans }}</a>
{% endblock %}
