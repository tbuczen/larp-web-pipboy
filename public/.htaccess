# Symfony front controller for Apache: serve existing files (assets) as they
# are and send every other request to index.php. Based on symfony/apache-pack.

DirectoryIndex index.php

# Web app manifest type, so browsers accept it for installation.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# The service worker must be revalidated on every check so updates reach phones.
<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Cache-Control "no-cache"
        Header set Service-Worker-Allowed "/"
    </Files>
</IfModule>

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Authorization header to PHP.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # Existing files, such as public/bundles assets, are served directly.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L]
</IfModule>
