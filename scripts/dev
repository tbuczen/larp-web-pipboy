#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

export DOCKER_CONFIG="${DOCKER_CONFIG:-${TMPDIR:-/tmp}/pipboy-docker-$(id -u)}"
mkdir -p "$DOCKER_CONFIG"

if [[ -z "${PIPBOY_PROXY_CA:-}" && -n "${CODEX_PROXY_CERT:-}" && -f "$CODEX_PROXY_CERT" ]]; then
    export PIPBOY_PROXY_CA="$CODEX_PROXY_CERT"
    export PIPBOY_PROXY_IP="$(getent ahostsv4 proxy | awk 'NR == 1 { print $1; exit }')"
fi

case "${1:-up}" in
    build)
        docker compose build app
        ;;
    install)
        docker compose run --rm --no-deps app composer install --no-interaction --prefer-dist
        ;;
    up)
        docker compose up -d --wait
        ;;
    down)
        docker compose down
        ;;
    test)
        docker compose exec -T -e APP_ENV=test app bash scripts/test
        ;;
    console)
        shift
        console_arguments=(-T)
        if [[ -t 0 && -t 1 ]]; then
            console_arguments=()
        fi
        docker compose exec "${console_arguments[@]}" app php bin/console "$@"
        ;;
    run)
        shift
        docker compose run --rm --no-deps app "$@"
        ;;
    composer)
        shift
        docker compose run --rm --no-deps app composer "$@"
        ;;
    logs)
        docker compose logs --tail=100
        ;;
    *)
        printf 'Usage: scripts/dev {build|install|up|down|test|console [arguments]|run [command]|composer [arguments]|logs}\n' >&2
        exit 2
        ;;
esac
